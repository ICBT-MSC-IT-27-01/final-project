{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=AnuradhapuraAI;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "FeatureFlags": {
    "EnableOfficerValidation": true,
    "EnableRecommendationHistory": true,
    "EnableClimateRiskIndicators": false,
    "EnableWeatherModelIntegration": true,
    "OperationalWeatherSource": "OpenMeteoForecastPastDays",
    "AcceptOperationalWeatherSource": true
  },
  "ForecastingService": {
    "BaseUrl": "http://127.0.0.1:8000"
  },
  "Jwt": {
    "Issuer": "AnuradhapuraAI.LocalDevelopment",
    "Audience": "AnuradhapuraAI.Angular.LocalDevelopment",
    "SigningKey": "local-development-only-key-set-a-user-secret-in-shared-environments",
    "ExpirationMinutes": 60
  }
}
