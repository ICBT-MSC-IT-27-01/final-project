flowchart LR
  U[Public and Registered User] --> P1[1.0 User Management]
  U --> P2[2.0 AI Weather Forecasting]
  U --> P3[3.0 Crop Suitability Assessment]
  U --> P4[4.0 Date Range Crop Planning]
  U --> P5[5.0 Crop Based Period Planning]
  O[Agricultural Officer] --> P6[6.0 Conditional Review and Validation]
  A[Administrator] --> P7[7.0 System Administration]
  Obs[(Operational observations)] --> P2
  Python[Python LSTM] <--> P2
  P2 --> Forecast[(ForecastRun and ForecastRecord)]
  Forecast --> P3
  Config[(Crop requirements, soil, weights and thresholds)] --> P3
  P3 -->|complete score or insufficient evidence| U
  P3 --> History[(Recommendation and crop results)]
  History --> P6
  P6 --> Validation[(Validation history)]
  Climate[(Historical ERA5 climate)] --> P4
  Climate --> P5
  Calendar[(DoA calendar month evidence)] --> P4
  Calendar --> P5
  P4 -->|conditional crop candidates| U
  P5 -->|approximate establishment months| U
  P7 --> Config
  P7 --> Users[(Users and roles)]
  Users --> P1
